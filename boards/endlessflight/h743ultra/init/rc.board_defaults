#!/bin/sh
# EndlessFlight H7Ultra manufacturer PX4 1.16.0 defaults, kept unchanged
param set-default BAT1_A_PER_V 40
param set-default BAT1_N_CELLS 6
param set-default BAT1_V_CHARGED 4.2
param set-default BAT1_V_DIV 21.12
param set-default BAT1_V_EMPTY 3.2
param set-default SYS_HAS_MAG 1
param set-default PWM_MAIN_TIM0 -4
param set-default RC_INPUT_PROTO -1
param set-default IMU_GYRO_CUTOFF 80
# Select the dedicated direct controller only when packaged.
if [ -f ${R}etc/init.d/airframes/22001_direct_actuator_controller ]
then
    param set-default SYS_AUTOSTART 22001
    param set-default RC_PORT_CONFIG 300
    param set-default RC_SBUS_PRT_CFG 0
    param set-default RC_CRSF_PRT_CFG 0
    param set-default GPS_1_CONFIG 0


    # Bench bring-up safety: inhibit physical LQI outputs.
    param set NN_LQI_OUTPUT_EN 0

else
    param set-default SYS_AUTOSTART 4001
fi
param set-default MC_PITCHRATE_K 0.4
param set-default MC_ROLLRATE_K 0.35
param set-default MC_YAWRATE_K 1.2
param set-default MC_YAWRATE_MAX 360
param set-default MAV_TYPE 2
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CBRK_SUPPLY_CHK 894281
