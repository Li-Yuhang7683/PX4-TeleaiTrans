#!/bin/sh
# EndlessFlight H7Ultra manufacturer sensor startup
board_adc start
# External IMU
sch16t -s -b 1 -R 2 start
# Internal dual IIM42652
iim42652 -s -b 2 -R 4 start
iim42652 -s -b 3 -R 6 start
# Internal barometer
spa06 -I -a 0x76 start
# Internal magnetometer, original vendor rotation and address
qmc5883p -I -a 0x2C -R 6 start

# H7ULTRA_NNCONTROL_OUTPUT_DEFAULTS
# Override airframe defaults, preserve saved QGC parameter values.
if [ -f ${R}etc/init.d/airframes/22001_direct_actuator_controller ]
then
    param set-default PWM_MAIN_TIM0 -4
    param set-default PWM_MAIN_TIM1 400
    param set-default PWM_MAIN_TIM2 400
    param set-default DSHOT_BIDIR_EN 1
    param set-default GPS_1_CONFIG 0
fi
